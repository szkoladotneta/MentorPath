@page "/mentor/mentees"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Invitations.Contracts
@using MentorPath.Application.Mentorships.Contracts
@inject IMentorshipService Mentorships
@inject IInvitationService Invitations
@inject IJSRuntime JS

<PageTitle>Mentees — MentorPath</PageTitle>

<Page>
    <PageHeader Title="Mentees" Subtitle="Relacje mentoringowe w Twoim workspace." />

    <SplitView Sticky="true">
        <Main>
            <PageState Loading="Loading" NotFound="NotFound">
                @if (mentees.Count == 0)
                {
                    <EmptyState Icon="users" Title="Nie masz jeszcze mentees">Zaproś pierwszą osobę formularzem obok.</EmptyState>
                }
                else
                {
                    <Section Title="Twoi mentees" Flush="true">
                        <Aside>@mentees.Count</Aside>
                        <ChildContent>
                            <DataList>
                                @foreach (var m in mentees)
                                {
                                    <DataRow>
                                        <ChildContent>
                                            <a href="@($"mentor/mentees/{m.MentorshipId}")" class="mp-datarow__title">@m.MenteeDisplayName</a>
                                            <div class="mp-datarow__meta">@m.MenteeEmail · od @Labels.Day(m.CreatedAtUtc)</div>
                                        </ChildContent>
                                        <Aside>
                                            @if (!m.OnboardingCompleted) { <Badge Tone="light" Label="Bez onboardingu" /> }
                                            <Badge Value="m.Status" />
                                        </Aside>
                                    </DataRow>
                                }
                            </DataList>
                        </ChildContent>
                    </Section>
                }
            </PageState>
        </Main>
        <Side>
            <Section Title="Zaproś mentee">
                <EditForm Model="invite" OnValidSubmit="InviteAsync">
                    <label class="form-label" for="invite-email">Adres e-mail</label>
                    <InputText id="invite-email" class="form-control" @bind-Value="invite.Email" placeholder="osoba@firma.pl" />
                    <FieldError Error="inviteError" Field="Email" />
                    <button type="submit" class="btn btn-primary mt-3" disabled="@(busy || !RendererInfo.IsInteractive)">Utwórz zaproszenie</button>
                </EditForm>
                <ErrorAlert Error="inviteError" ShowFieldList="false" />
                @if (created is not null)
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <div class="small mb-2">Link ważny do @Labels.Date(created.ExpiresAtUtc). Skopiuj i przekaż mentee — link jest pokazywany tylko raz.</div>
                        <input class="form-control form-control-sm mono-break" readonly value="@created.AcceptUrl" aria-label="Link do zaproszenia" />
                        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="CopyAsync">@(copied ? "Skopiowano" : "Kopiuj link")</button>
                    </div>
                }
            </Section>
            <Section Title="Zaproszenia" Flush="@(invitations.Count > 0)">
                @if (invitations.Count == 0)
                {
                    <p class="small text-secondary mb-0">Brak zaproszeń.</p>
                }
                <DataList>
                    @foreach (var i in invitations)
                    {
                        <DataRow Class="small">
                            <ChildContent>
                                <div class="mono-break">@i.Email</div>
                                <div class="mp-datarow__meta">utworzone @Labels.Date(i.CreatedAtUtc)</div>
                            </ChildContent>
                            <Aside><Badge Value="i.State" /></Aside>
                        </DataRow>
                    }
                </DataList>
            </Section>
        </Side>
    </SplitView>
</Page>

@code {
    private List<MentorMenteeListItem> mentees = [];
    private List<InvitationListItem> invitations = [];
    private readonly InviteModel invite = new();
    private CreateInvitationResult? created;
    private AppError? inviteError;
    private bool busy;
    private bool copied;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var user = await GetUserIdAsync();
        var list = await Mentorships.ListForMentorAsync(user, Ct);
        if (Handle(list)) mentees = list.Value!.ToList();
        var inv = await Invitations.ListAsync(user, Ct);
        if (inv.IsSuccess) invitations = inv.Value!.ToList();
        Loading = false;
    }

    private async Task InviteAsync()
    {
        busy = true;
        copied = false;
        created = null;
        var result = await Invitations.CreateAsync(await GetUserIdAsync(), new CreateInvitationRequest(invite.Email), Ct);
        if (result.IsSuccess)
        {
            created = result.Value;
            inviteError = null;
            invite.Email = "";
            await LoadAsync();
        }
        else inviteError = result.Error;
        busy = false;
    }

    private async Task CopyAsync()
    {
        if (created is not null) copied = await JS.InvokeAsync<bool>("mentorPath.copyText", created.AcceptUrl);
    }

    private sealed class InviteModel
    {
        public string Email { get; set; } = "";
    }
}
