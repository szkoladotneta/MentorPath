@page "/app/mentorships"
@attribute [Authorize(Roles = AppRoles.Mentee)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Mentorships.Contracts
@inject IMentorshipService Mentorships

<PageTitle>Moje mentoringi — MentorPath</PageTitle>

<Page Width="wide">
    <PageHeader Title="Wybierz mentoring" Subtitle="Każda relacja mentoringowa to osobna przestrzeń z własną roadmapą i historią." />

    <PageState Loading="Loading" NotFound="NotFound">
        @if (items.Count == 0)
        {
            <EmptyState Icon="users" Title="Nie masz aktywnych mentoringów">Poproś mentora o zaproszenie.</EmptyState>
        }
        else
        {
            <Section Flush="true">
                <DataList>
                    @foreach (var m in items)
                    {
                        <DataRow Title="@m.WorkspaceName" Meta="@($"Mentor: {m.MentorDisplayName}")">
                            <Aside>
                                <Badge Value="m.Status" />
                                <a class="btn btn-primary btn-sm" href="@($"app/roadmap/{m.MentorshipId}")">Roadmapa</a>
                                <a class="btn btn-outline-primary btn-sm" href="@($"app/progress/{m.MentorshipId}")">Postęp</a>
                                <a class="btn btn-outline-secondary btn-sm" href="@($"app/profile?mentorshipId={m.MentorshipId}")">@(m.OnboardingCompleted ? "Profil" : "Uzupełnij onboarding")</a>
                            </Aside>
                        </DataRow>
                    }
                </DataList>
            </Section>
        }
    </PageState>
</Page>

@code {
    private List<MenteeMentorshipListItem> items = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await Mentorships.ListForMenteeAsync(await GetUserIdAsync(), Ct);
        if (Handle(result)) items = result.Value!.ToList();
        Loading = false;
    }
}
