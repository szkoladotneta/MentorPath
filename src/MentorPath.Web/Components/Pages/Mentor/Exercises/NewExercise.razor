@page "/mentor/exercises/new"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.AiAuthoring.Contracts
@using MentorPath.Application.Catalog.Contracts
@inject ITopicService Topics
@inject IExerciseAuthoringService Exercises
@inject IAiExerciseDraftService Ai

<PageTitle>Nowe ćwiczenie — MentorPath</PageTitle>

<Page>
    <PageHeader Title="Nowe ćwiczenie" Subtitle="Wygeneruj szkic z pomocą AI albo utwórz ćwiczenie ręcznie. Każda treść zaczyna jako szkic." />

    <PageState Loading="Loading" NotFound="NotFound">
        @if (topics.Count == 0)
        {
            <EmptyState Icon="library" Title="Najpierw utwórz temat"><a href="mentor/catalog/topics">Przejdź do katalogu</a></EmptyState>
        }
        else
        {
            <SplitView Sticky="true">
                <Main>
                    <Section Title="Parametry">
                        <div class="mb-3">
                            <label class="form-label" for="ex-topic">Temat</label>
                            <select id="ex-topic" class="form-select" @bind="topicId">
                                @foreach (var t in topics)
                                {
                                    <option value="@t.TopicId">@t.Title</option>
                                }
                            </select>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label" for="ex-type">Typ ćwiczenia</label>
                                <select id="ex-type" class="form-select" @bind="type">
                                    @foreach (var t in Enum.GetValues<ExerciseType>())
                                    {
                                        <option value="@t">@Labels.Of(t)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label" for="ex-difficulty">Poziom trudności</label>
                                <select id="ex-difficulty" class="form-select" @bind="difficulty">
                                    @foreach (var d in Enum.GetValues<Difficulty>())
                                    {
                                        <option value="@d">@Labels.Of(d)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ex-objectives">Cele edukacyjne</label>
                            <textarea id="ex-objectives" class="form-control" rows="3" @bind="objectives"></textarea>
                            <FieldError Error="Error" Field="LearningObjectives" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ex-context">Kontekst lub ograniczenia</label>
                            <textarea id="ex-context" class="form-control" rows="3" @bind="context"></textarea>
                            <div class="form-text">Nie wpisuj danych osobowych mentees — ta treść trafia do dostawcy AI.</div>
                        </div>
                        <div class="mb-4 field-narrow">
                            <label class="form-label" for="ex-minutes">Szacowany czas (min)</label>
                            <input id="ex-minutes" type="number" class="form-control" @bind="minutes" />
                        </div>
                        <ErrorAlert Error="Error" ShowFieldList="false" />
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@busy">
                                @if (generating) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                                Generate with AI
                            </button>
                            <button class="btn btn-outline-primary" @onclick="CreateManualAsync" disabled="@busy">Utwórz ręcznie</button>
                        </div>
                        @if (quota is not null)
                        {
                            <div class="small text-secondary mt-3">Limit AI: @quota.Used / @quota.Limit w tym miesiącu.</div>
                        }
                    </Section>
                </Main>
                <Side>
                    <Section Title="Jak to działa">
                        <ol class="small mb-0 ps-3">
                            <li>AI tworzy szkic: scenariusz, instrukcje, kryteria oceny, prywatny mentor guide i — dla quizu — opcje odpowiedzi.</li>
                            <li>Odpowiedź AI jest walidowana (schemat, reguły domenowe, brak HTML) i zapisywana jako <strong>szkic</strong>.</li>
                            <li>Przejrzyj i popraw treść w edytorze. AI może się mylić — odpowiadasz za merytorykę.</li>
                            <li>Opublikuj ćwiczenie jawną akcją. Dopiero opublikowane ćwiczenie można przypisać na roadmapie.</li>
                        </ol>
                    </Section>
                </Side>
            </SplitView>
        }
    </PageState>
</Page>

@code {
    [SupplyParameterFromQuery(Name = "topicId")] public Guid? InitialTopicId { get; set; }

    private List<TopicListItem> topics = [];
    private Guid topicId;
    private ExerciseType type = ExerciseType.ArchitecturalDecision;
    private Difficulty difficulty = Difficulty.Intermediate;
    private string objectives = "";
    private string? context;
    private int? minutes = 45;
    private AiQuotaDto? quota;
    private bool busy;
    private bool generating;

    protected override async Task OnInitializedAsync()
    {
        var user = await GetUserIdAsync();
        var result = await Topics.ListAsync(user, false, Ct);
        if (Handle(result)) topics = result.Value!.ToList();
        topicId = topics.Any(t => t.TopicId == InitialTopicId) ? InitialTopicId!.Value : topics.FirstOrDefault()?.TopicId ?? Guid.Empty;
        var q = await Ai.GetQuotaAsync(user, Ct);
        if (q.IsSuccess) quota = q.Value;
        Loading = false;
    }

    private async Task GenerateAsync()
    {
        busy = generating = true;
        var result = await Ai.GenerateDraftAsync(await GetUserIdAsync(),
            new GenerateExerciseDraftRequest(topicId, type, difficulty, objectives, context, minutes), Ct);
        busy = generating = false;
        if (Handle(result)) Nav.NavigateTo($"mentor/exercises/{result.Value!.ExerciseId}/edit");
        else
        {
            var q = await Ai.GetQuotaAsync(await GetUserIdAsync(), Ct);
            if (q.IsSuccess) quota = q.Value;
        }
    }

    private async Task CreateManualAsync()
    {
        busy = true;
        var title = type switch
        {
            ExerciseType.QuizSingleChoice => "Nowy quiz",
            ExerciseType.PracticalTask => "Nowe zadanie praktyczne",
            _ => "Nowa decyzja architektoniczna",
        };
        var content = new ExerciseContent(title, "", null, null, null, null, null, null, minutes, []);
        var result = await Exercises.CreateDraftAsync(await GetUserIdAsync(), new CreateExerciseDraftRequest(topicId, type, content), Ct);
        busy = false;
        if (Handle(result)) Nav.NavigateTo($"mentor/exercises/{result.Value}/edit");
    }
}
