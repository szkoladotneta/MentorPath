@page "/mentor"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Progress.Contracts
@inject IProgressService Progress

<PageTitle>Dashboard mentora — MentorPath</PageTitle>

<Page>
    <PageHeader Title="Dashboard" Subtitle="Twoi mentees, oczekujące review i ostatnia aktywność.">
        <Actions>
            <a class="btn btn-outline-primary" href="mentor/catalog/topics">Katalog</a>
            <a class="btn btn-primary" href="mentor/exercises/new">Nowe ćwiczenie</a>
        </Actions>
    </PageHeader>

    <PageState Loading="Loading" NotFound="NotFound">
        @if (data is not null)
        {
            <div class="mp-stats">
                <StatTile Label="Mentees" Value="@data.Mentees.Count.ToString()" />
                <StatTile Label="Czeka na ocenę" Value="@data.PendingReviews.Count.ToString()" Attention="@(data.PendingReviews.Count > 0)" />
                <StatTile Label="Aktywność (30 dni)" Value="@data.RecentActivity.Count.ToString()" />
            </div>

            <SplitView Sticky="true">
                <Main>
                    <Section Title="Mentees i postęp" Flush="true">
                        <Aside><a href="mentor/mentees">Zarządzaj</a></Aside>
                        <ChildContent>
                            @if (data.Mentees.Count == 0)
                            {
                                <EmptyState Icon="users" Title="Brak mentees"><a href="mentor/mentees">Zaproś pierwszą osobę</a></EmptyState>
                            }
                            <DataList>
                                @foreach (var m in data.Mentees)
                                {
                                    var percent = m.CountedTopics == 0 ? 0 : 100 * m.CompletedTopics / m.CountedTopics;
                                    <DataRow>
                                        <ChildContent>
                                            <a href="@($"mentor/mentees/{m.MentorshipId}")" class="mp-datarow__title">@m.MenteeDisplayName</a>
                                            <div class="mp-datarow__meta">
                                                @(m.HasPublishedRoadmap ? $"{m.CompletedTopics}/{m.CountedTopics} tematów" : "brak opublikowanej roadmapy")
                                                · ostatnia próba: @Labels.Date(m.LastSubmissionAtUtc)
                                            </div>
                                            @if (m.HasPublishedRoadmap)
                                            {
                                                <div class="progress mt-2 mp-max-sm" role="progressbar" aria-label="Postęp: @(percent)%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@(percent)%"></div></div>
                                            }
                                        </ChildContent>
                                        <Aside>
                                            @if (m.PendingReviewCount > 0) { <Badge Tone="info" Label="@($"{m.PendingReviewCount} do oceny")" /> }
                                            <Badge Value="m.Status" />
                                        </Aside>
                                    </DataRow>
                                }
                            </DataList>
                        </ChildContent>
                    </Section>

                    <Section Title="Ostatnia aktywność (30 dni)" Flush="@(data.RecentActivity.Count > 0)">
                        @if (data.RecentActivity.Count == 0)
                        {
                            <p class="small text-secondary mb-0">Brak aktywności.</p>
                        }
                        <DataList>
                            @foreach (var a in data.RecentActivity)
                            {
                                <DataRow Class="small">
                                    <ChildContent><strong>@a.MenteeDisplayName</strong> @Labels.Of(a.Kind): @a.ExerciseTitle</ChildContent>
                                    <Aside><span class="text-secondary text-nowrap">@Labels.Date(a.OccurredAtUtc)</span></Aside>
                                </DataRow>
                            }
                        </DataList>
                    </Section>
                </Main>
                <Side>
                    <Section Title="Oczekujące review" Flush="@(data.PendingReviews.Count > 0)">
                        <Aside><a href="mentor/reviews">Kolejka</a></Aside>
                        <ChildContent>
                            @if (data.PendingReviews.Count == 0)
                            {
                                <p class="small text-secondary mb-0">Nic nie czeka na ocenę.</p>
                            }
                            <DataList>
                                @foreach (var p in data.PendingReviews.Take(8))
                                {
                                    <DataRow Href="@($"mentor/reviews/{p.SubmissionId}")" Title="@p.ExerciseTitle"
                                             Meta="@($"{p.MenteeDisplayName} · próba #{p.AttemptNumber} · {Labels.Date(p.SubmittedAtUtc)}")" />
                                }
                            </DataList>
                        </ChildContent>
                    </Section>
                </Side>
            </SplitView>
        }
    </PageState>
</Page>

@code {
    private MentorDashboardDto? data;

    protected override async Task OnInitializedAsync()
    {
        var result = await Progress.GetMentorDashboardAsync(await GetUserIdAsync(), Ct);
        if (Handle(result)) data = result.Value;
        Loading = false;
    }
}
