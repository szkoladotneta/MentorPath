<header class="mp-page-header">
    <div class="mp-page-header__text">
        @if (Crumbs is { Count: > 0 })
        {
            <nav class="mp-crumbs" aria-label="Ścieżka nawigacji">
                <ol>
                    @for (var i = 0; i < Crumbs.Count; i++)
                    {
                        var crumb = Crumbs[i];
                        <li>
                            @if (crumb.Href is not null && i < Crumbs.Count - 1)
                            {
                                <a href="@crumb.Href">@crumb.Text</a>
                            }
                            else
                            {
                                <span aria-current="page">@crumb.Text</span>
                            }
                        </li>
                    }
                </ol>
            </nav>
        }
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="mp-page-header__subtitle">@Subtitle</p>
        }
        @ChildContent
    </div>
    @if (Actions is not null)
    {
        <div class="mp-page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public IReadOnlyList<Crumb>? Crumbs { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
