<svg class="mp-icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "dashboard":
            <rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" /><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8" /><path d="M18 14.4c2.2.6 3.5 2.6 3.5 5.6" />
            break;
        case "library":
            <path d="M4 4v16" /><path d="M9 4v16" /><path d="M14 5.5l4.5-1.5 2 15-4.5 1.5z" />
            break;
        case "file-plus":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /><path d="M12 11.5v6" /><path d="M9 14.5h6" />
            break;
        case "clipboard-check":
            <rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4h6v3H9z" /><path d="M9 14l2 2 4-4.5" />
            break;
        case "sliders":
            <path d="M4 7h9" /><path d="M17 7h3" /><circle cx="15" cy="7" r="2" /><path d="M4 17h3" /><path d="M11 17h9" /><circle cx="9" cy="17" r="2" />
            break;
        case "map":
            <path d="M9 4L3 6.5v13L9 17l6 3 6-2.5v-13L15 7z" /><path d="M9 4v13" /><path d="M15 7v13" />
            break;
        case "trending-up":
            <path d="M3 17l6-6 4 4 8-8" /><path d="M15 7h6v6" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
            break;
        case "swap":
            <path d="M4 8h14" /><path d="M14 4l4 4-4 4" /><path d="M20 16H6" /><path d="M10 12l-4 4 4 4" />
            break;
        case "log-out":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" />
            break;
        case "menu":
            <path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />
            break;
        case "x":
            <path d="M6 6l12 12" /><path d="M18 6L6 18" />
            break;
        case "chevrons-left":
            <path d="M11 17l-5-5 5-5" /><path d="M18 17l-5-5 5-5" />
            break;
        case "chevron-down":
            <path d="M6 9l6 6 6-6" />
            break;
        case "chevron-right":
            <path d="M9 6l6 6-6 6" />
            break;
        case "key":
            <circle cx="8" cy="15" r="4" /><path d="M11 12l9-9" /><path d="M16 7l3 3" />
            break;
        case "inbox":
            <path d="M3 13l3-8h12l3 8" /><path d="M3 13v6a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1v-6" /><path d="M3 13h5a4 4 0 0 0 8 0h5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Class { get; set; }
}
