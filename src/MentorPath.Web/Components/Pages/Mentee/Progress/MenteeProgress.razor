@page "/app/progress/{MentorshipId:guid}"
@attribute [Authorize(Roles = AppRoles.Mentee)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Progress.Contracts
@inject IProgressService Progress

<PageTitle>Postęp — MentorPath</PageTitle>

<Page Width="wide">
    <PageState Loading="Loading" NotFound="NotFound">
        @if (progress is not null)
        {
            <PageHeader Title="Postęp" Subtitle="Postęp zadań wynika z zaliczonych wymaganych ćwiczeń; status kompetencji nadaje mentor. Pewność to Twoja samoocena."
                        Crumbs="@(new Crumb[] { new("Moje mentoringi", "app/mentorships"), new("Roadmapa", $"app/roadmap/{MentorshipId}"), new("Postęp") })" />
            @if (!progress.HasPublishedRoadmap)
            {
                <EmptyState Icon="map" Title="Brak opublikowanej roadmapy">Postęp pojawi się, gdy mentor opublikuje roadmapę.</EmptyState>
            }
            else
            {
                <Section>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Ukończone tematy: <strong>@progress.CompletedTopics / @progress.CountedTopics</strong></span>
                        <strong>@progress.PercentComplete%</strong>
                    </div>
                    <div class="progress"><div class="progress-bar" style="width:@(progress.PercentComplete)%"></div></div>
                </Section>
                @if (progress.CompetencyProgress is { } competencyProgress)
                {
                    <Section Title="Status kompetencji">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Wykazane kompetencje: <strong>@competencyProgress.DemonstratedCompetencies / @competencyProgress.ActiveCompetencies</strong></span>
                            <strong>@competencyProgress.PercentComplete%</strong>
                        </div>
                        <div class="progress" role="progressbar" aria-label="Wykazane kompetencje"
                             aria-valuenow="@competencyProgress.PercentComplete" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width:@(competencyProgress.PercentComplete)%"></div>
                        </div>
                    </Section>
                }
                @foreach (var t in progress.Topics)
                {
                    <Section Title="@t.TopicTitle" Flush="true">
                        <Aside>
                            <span class="text-secondary">@(t.CountsTowardsProgress ? $"{t.CompletedRequired}/{t.TotalRequired} wymaganych" : "bez wymaganych zadań")</span>
                            <Badge Value="t.Status" />
                        </Aside>
                        <ChildContent>
                            <DataList>
                                @foreach (var a in t.Assignments)
                                {
                                    <DataRow Href="@($"app/assignments/{a.AssignmentId}")" Title="@a.ExerciseTitle" Meta="@AssignmentMeta(a.IsRequired, a.LatestConfidenceBefore, a.LatestConfidenceAfter)">
                                        <Aside><Badge Value="a.Status" /></Aside>
                                    </DataRow>
                                }
                            </DataList>
                        </ChildContent>
                    </Section>
                }
            }
        }
    </PageState>
</Page>

@code {
    [Parameter] public Guid MentorshipId { get; set; }

    private RoadmapProgressDto? progress;

    private static string AssignmentMeta(bool required, int? confidenceBefore, int? confidenceAfter) =>
        (required ? "wymagane" : "opcjonalne")
        + (confidenceBefore is not null ? $" · pewność przed: {confidenceBefore}/5" : "")
        + (confidenceAfter is not null ? $" · po: {confidenceAfter}/5" : "");

    protected override async Task OnParametersSetAsync()
    {
        var result = await Progress.GetRoadmapProgressAsync(await GetUserIdAsync(), MentorshipId, Ct);
        if (Handle(result)) progress = result.Value;
        Loading = false;
    }
}
