@page "/mentor/reviews"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Reviews.Contracts
@inject IReviewService Reviews

<PageTitle>Kolejka review — MentorPath</PageTitle>

<Page>
    <PageHeader Title="Kolejka review" Subtitle="Rozwiązania czekające na Twoją ocenę (najstarsze najpierw)." />

    <PageState Loading="Loading" NotFound="NotFound">
        @if (items.Count == 0)
        {
            <EmptyState Icon="clipboard-check" Title="Kolejka jest pusta">Nic nie czeka na ocenę.</EmptyState>
        }
        else
        {
            <DataList Bordered="true">
                @foreach (var p in items)
                {
                    <DataRow Href="@($"mentor/reviews/{p.SubmissionId}")" Title="@p.ExerciseTitle"
                             Meta="@($"{p.MenteeDisplayName} · {Labels.Of(p.Type)} · próba #{p.AttemptNumber}")">
                        <Aside>
                            <div class="small text-secondary text-end">
                                <div>przesłano @Labels.Date(p.SubmittedAtUtc)</div>
                                @if (p.DueAtUtc is not null) { <div>termin @Labels.Day(p.DueAtUtc)</div> }
                            </div>
                        </Aside>
                    </DataRow>
                }
            </DataList>
        }
    </PageState>
</Page>

@code {
    private List<PendingReviewItem> items = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await Reviews.GetPendingAsync(await GetUserIdAsync(), Ct);
        if (Handle(result)) items = result.Value!.ToList();
        Loading = false;
    }
}
