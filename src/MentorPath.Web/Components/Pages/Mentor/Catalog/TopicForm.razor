@using MentorPath.Application.Catalog
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="topic-title">Tytuł</label>
        <input id="topic-title" class="form-control" value="@Model.Title" @onchange="OnTitleChanged" />
        <FieldError Error="Error" Field="Title" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="topic-slug">Slug</label>
        <InputText id="topic-slug" class="form-control" @bind-Value="Model.Slug" />
        <FieldError Error="Error" Field="Slug" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="topic-category">Kategoria</label>
        <InputText id="topic-category" class="form-control" @bind-Value="Model.Category" placeholder="np. Architektura, Dane, Integracje" />
        <FieldError Error="Error" Field="Category" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="topic-difficulty">Poziom trudności</label>
        <InputSelect id="topic-difficulty" class="form-select" @bind-Value="Model.Difficulty">
            @foreach (var d in Enum.GetValues<Difficulty>())
            {
                <option value="@d">@Labels.Of(d)</option>
            }
        </InputSelect>
    </div>
    <div class="col-12">
        <label class="form-label" for="topic-description">Opis (Markdown)</label>
        <InputTextArea id="topic-description" class="form-control" rows="4" @bind-Value="Model.DescriptionMarkdown" />
        <FieldError Error="Error" Field="DescriptionMarkdown" />
    </div>
    <div class="col-12">
        <label class="form-label" for="topic-objectives">Cele edukacyjne (Markdown)</label>
        <InputTextArea id="topic-objectives" class="form-control" rows="4" @bind-Value="Model.LearningObjectivesMarkdown" />
        <FieldError Error="Error" Field="LearningObjectivesMarkdown" />
    </div>
    <div class="col-12">
        <label class="form-label" for="topic-why-it-matters">Dlaczego to ważne (Markdown, opcjonalnie)</label>
        <InputTextArea id="topic-why-it-matters" class="form-control" rows="4" maxlength="20000" @bind-Value="Model.WhyItMattersMarkdown" />
        <FieldError Error="Error" Field="WhyItMattersMarkdown" />
    </div>
</div>
<ErrorAlert Error="Error" ShowFieldList="false" />

@code {
    [Parameter, EditorRequired] public TopicFormModel Model { get; set; } = default!;
    [Parameter] public AppError? Error { get; set; }

    private void OnTitleChanged(ChangeEventArgs e)
    {
        var previousAuto = ExerciseValidator.Slugify(Model.Title);
        Model.Title = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(Model.Slug) || Model.Slug == previousAuto) Model.Slug = ExerciseValidator.Slugify(Model.Title);
    }
}
