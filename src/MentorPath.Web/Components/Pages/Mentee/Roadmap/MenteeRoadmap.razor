@page "/app/roadmap/{MentorshipId:guid}"
@attribute [Authorize(Roles = AppRoles.Mentee)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Roadmaps.Contracts
@using MentorPath.Web.Components.Modules.Progress
@using MentorPath.Web.Components.Modules.Roadmaps
@inject IRoadmapService Roadmaps

<PageTitle>Roadmapa — MentorPath</PageTitle>

<Page Width="wide">
    <PageState Loading="Loading" NotFound="false">
        @if (roadmap is null)
        {
            <EmptyState Icon="map" Title="Roadmapa nie jest jeszcze dostępna">Mentor nie opublikował roadmapy dla tego mentoringu. <a href="app">Wróć do dashboardu</a></EmptyState>
        }
        else
        {
            <PageHeader Title="@roadmap.Title" Crumbs="@(new Crumb[] { new("Moje mentoringi", "app/mentorships"), new("Roadmapa") })">
                <Actions>
                    <a class="btn btn-outline-primary" href="@($"app/progress/{MentorshipId}")">Postęp</a>
                </Actions>
            </PageHeader>
            <SplitView>
                <Main>
                    <Tabs Items="viewTabs" Selected="@(showMap ? "map" : "list")" SelectedChanged="SetView" IdPrefix="rm" Label="Widok roadmapy" />
                    @if (showMap)
                    {
                        <div role="tabpanel" id="rm-panel-map" aria-labelledby="rm-tab-map">
                            <RoadmapMap MentorshipId="MentorshipId" />
                        </div>
                    }
                    else
                    {
                    <div role="tabpanel" id="rm-panel-list" aria-labelledby="rm-tab-list" class="mp-stack">
                    @foreach (var item in roadmap.Items)
                    {
                        <Section Title="@($"{item.Position + 1}. {item.TopicTitle}")">
                            <Markdown Value="@item.TopicDescriptionMarkdown" Class="small text-secondary mb-2" />
                            @if (!string.IsNullOrWhiteSpace(item.MentorNoteMarkdown))
                            {
                                <div class="alert alert-light small py-2"><strong>Notatka mentora:</strong> <Markdown Value="@item.MentorNoteMarkdown" /></div>
                            }
                            <DataList>
                                @foreach (var a in item.Assignments)
                                {
                                    <DataRow Class="px-0" Href="@($"app/assignments/{a.AssignmentId}")" Title="@a.ExerciseTitle" Meta="@AssignmentMeta(a.Type, a.IsRequired, a.DueAtUtc, a.AttemptCount)">
                                        <Aside>
                                            @if (a.LatestStatus is { } s) { <Badge Value="s" /> } else { <Badge Tone="light" Label="Nierozpoczęte" /> }
                                        </Aside>
                                    </DataRow>
                                }
                            </DataList>
                        </Section>
                    }
                    </div>
                    }
                </Main>
                <Side>
                    <Section Title="Cel">
                        <Markdown Value="@roadmap.ObjectiveMarkdown" />
                    </Section>
                    <Section Title="Twój postęp">
                        <RoadmapProgressSummary MentorshipId="MentorshipId" ShowTopics="true" />
                    </Section>
                </Side>
            </SplitView>
        }
    </PageState>
</Page>

@code {
    [Parameter] public Guid MentorshipId { get; set; }

    private MenteeRoadmapDto? roadmap;
    private bool showMap = true;
    private void SetView(string view) => showMap = view == "map";
    private static readonly IReadOnlyList<TabItem> viewTabs = [new("map", "Mapa"), new("list", "Lista")];

    private static string AssignmentMeta(ExerciseType type, bool required, DateTime? dueAtUtc, int attemptCount) =>
        $"{Labels.Of(type)} · {(required ? "wymagane" : "opcjonalne")}"
        + (dueAtUtc is not null ? $" · termin {Labels.Day(dueAtUtc)}" : "")
        + (attemptCount > 0 ? $" · prób: {attemptCount}" : "");

    protected override async Task OnParametersSetAsync()
    {
        var result = await Roadmaps.GetForMenteeAsync(await GetUserIdAsync(), MentorshipId, Ct);
        roadmap = result.IsSuccess ? result.Value : null;
        Loading = false;
    }
}
