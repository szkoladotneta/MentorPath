@if (Loading)
{
    <div class="mp-skeleton" role="status" aria-live="polite">
        <span class="visually-hidden-label">Ładowanie…</span>
        <div class="mp-skeleton__bar mp-skeleton__bar--title"></div>
        <div class="mp-skeleton__bar"></div>
        <div class="mp-skeleton__bar"></div>
        <div class="mp-skeleton__bar"></div>
    </div>
}
else if (NotFound)
{
    <EmptyState Icon="search" Title="Nie znaleziono">Zasób nie istnieje albo nie masz do niego dostępu.</EmptyState>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool NotFound { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
