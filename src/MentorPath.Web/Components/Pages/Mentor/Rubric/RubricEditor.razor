@page "/mentor/rubric"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Catalog.Contracts
@inject IRubricService Rubric

<PageTitle>Rubryka — MentorPath</PageTitle>

<Page>
    <PageHeader Title="Rubryka procesu decyzyjnego" Subtitle="Kryteria oceny w Twoim workspace. Każde ma opis poziomów 1–5; mentee zobaczy opis przyznanego poziomu.">
        <Actions>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="show-inactive" checked="@showInactive" @onchange="ToggleInactive" />
                <label class="form-check-label small" for="show-inactive">Pokaż nieaktywne</label>
            </div>
        </Actions>
    </PageHeader>

    <PageState Loading="Loading" NotFound="NotFound">
        @if (message is not null) { <div class="alert alert-success mb-0" role="status">@message</div> }
        @if (editingId is null) { <ErrorAlert Error="Error" /> }
        @if (Visible.Count == 0)
        {
            <EmptyState Icon="sliders" Title="Brak kryteriów">Nie znaleziono kryteriów do wyświetlenia.</EmptyState>
        }
        @for (var i = 0; i < Visible.Count; i++)
        {
            var index = i;
            var c = Visible[index];
            <Section Title="@c.Name" Class="@(c.IsActive ? null : "mp-criterion--inactive")">
                <Aside>
                    @if (!c.IsActive) { <Badge Tone="neutral" Label="Nieaktywne" /> }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveAsync(index, -1)" disabled="@(busy || index == 0)" aria-label="@($"Przesuń wyżej: {c.Name}")">Wyżej</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => MoveAsync(index, 1)" disabled="@(busy || index == Visible.Count - 1)" aria-label="@($"Przesuń niżej: {c.Name}")">Niżej</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(c)" disabled="@busy">Edytuj</button>
                    <button class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => SetActiveAsync(c)" disabled="@busy">
                        @(c.IsActive ? "Dezaktywuj" : "Aktywuj")
                    </button>
                </Aside>
                <ChildContent>
                    @if (editingId == c.CriterionId)
                    {
                        <ErrorAlert Error="Error" ShowFieldList="false" />
                        <div class="mb-3">
                            <label class="form-label" for="criterion-name">Nazwa</label>
                            <input class="form-control" id="criterion-name" @bind="editName" />
                            <FieldError Error="Error" Field="Name" />
                        </div>
                        @for (var level = 0; level < 5; level++)
                        {
                            var l = level;
                            <div class="mb-2">
                                <label class="form-label" for="@($"criterion-level-{l}")">Poziom @(l + 1)</label>
                                <textarea class="form-control" id="@($"criterion-level-{l}")" rows="2" value="@editLevels[l]" @onchange="e => editLevels[l] = e.Value?.ToString() ?? string.Empty"></textarea>
                                <FieldError Error="Error" Field="@($"LevelDescriptions[{l}]")" />
                            </div>
                        }
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@busy">Zapisz</button>
                            <button class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@busy">Anuluj</button>
                        </div>
                    }
                    else
                    {
                        <dl class="kv mb-0">
                            @for (var level = 0; level < c.LevelDescriptions.Count; level++)
                            {
                                <dt>Poziom @(level + 1)</dt>
                                <dd>@c.LevelDescriptions[level]</dd>
                            }
                        </dl>
                    }
                </ChildContent>
            </Section>
        }
    </PageState>
</Page>

@code {
    private IReadOnlyList<RubricCriterionDto> all = [];
    private bool showInactive;
    private bool busy;
    private string? message;
    private Guid? editingId;
    private string editName = "";
    private string[] editLevels = new string[5];

    private IReadOnlyList<RubricCriterionDto> Visible => showInactive ? all : all.Where(c => c.IsActive).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Rubric.ListCriteriaAsync(await GetUserIdAsync(), true, Ct);
        if (Handle(result)) all = result.Value!;
        Loading = false;
    }

    private void ToggleInactive()
    {
        showInactive = !showInactive;
        message = null;
    }

    private void StartEdit(RubricCriterionDto c)
    {
        message = null;
        Error = null;
        editingId = c.CriterionId;
        editName = c.Name;
        editLevels = c.LevelDescriptions.ToArray();
    }

    private void CancelEdit()
    {
        editingId = null;
        Error = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        var result = await Rubric.UpdateCriterionAsync(await GetUserIdAsync(), editingId!.Value, new UpdateRubricCriterionRequest(editName, editLevels), Ct);
        if (Handle(result))
        {
            editingId = null;
            await LoadAsync();
            message = "Zapisano kryterium.";
        }
        busy = false;
    }

    private async Task SetActiveAsync(RubricCriterionDto c)
    {
        busy = true;
        message = null;
        editingId = null;
        if (Handle(await Rubric.SetActiveAsync(await GetUserIdAsync(), c.CriterionId, !c.IsActive, Ct))) await LoadAsync();
        busy = false;
    }

    // The service needs the full ordering, so swap with the neighbouring visible item inside the complete list.
    private async Task MoveAsync(int visibleIndex, int delta)
    {
        busy = true;
        message = null;
        var visible = Visible;
        var ids = all.Select(c => c.CriterionId).ToList();
        var from = ids.IndexOf(visible[visibleIndex].CriterionId);
        var to = ids.IndexOf(visible[visibleIndex + delta].CriterionId);
        (ids[from], ids[to]) = (ids[to], ids[from]);
        if (Handle(await Rubric.ReorderAsync(await GetUserIdAsync(), ids, Ct))) await LoadAsync();
        busy = false;
    }
}
