@inherits AppComponentBase
@using MentorPath.Application.Progress
@using MentorPath.Application.Progress.Contracts
@using MentorPath.Application.Roadmaps.Contracts
@inject IRoadmapMapService MapService
@inject IRoadmapService Roadmaps

@if (Loading)
{
    <div class="small text-secondary" role="status">Ładowanie mapy…</div>
}
else if (NotFound)
{
    <EmptyState Title="Nie znaleziono">Mapa roadmapy jest niedostępna.</EmptyState>
}
else if (Error is not null)
{
    <ErrorAlert Error="Error" />
}
else if (map is null || !map.HasRoadmap || map.Nodes.Count == 0)
{
    <EmptyState Title="Mapa jest pusta">@(MentorView ? "Dodaj tematy do roadmapy, aby zobaczyć mapę." : "Mentor nie dodał jeszcze tematów do roadmapy.")</EmptyState>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div class="map-legend" aria-label="Legenda mapy">
            @foreach (var s in LegendStates)
            {
                <span><span class="legend-icon">@Labels.Icon(s)</span>@Labels.Of(s)</span>
            }
        </div>
        <div class="small">Ukończone: <strong>@map.CompletedTopics / @map.CountedTopics</strong> (@map.PercentComplete%)</div>
    </div>

    <div class="roadmap-map">
        <svg width="@Num(layout.Width)" height="@Num(layout.Height)" viewBox="0 0 @Num(layout.Width) @Num(layout.Height)"
             role="group" aria-label="Mapa roadmapy: @map.RoadmapTitle">
            @foreach (var edge in layout.Edges)
            {
                var done = !edge.IsBranch && byId[edge.FromKey].State == MapNodeState.Completed;
                <path class="map-edge @(edge.IsBranch ? "branch" : "") @(done ? "done" : "")" d="@edge.Path" />
            }
            @foreach (var p in layout.Nodes)
            {
                var node = byId[p.Key];
                <g class="map-node state-@node.State @(selectedId == node.TopicId ? "selected" : "")" tabindex="0" role="button"
                   aria-pressed="@(selectedId == node.TopicId ? "true" : "false")"
                   aria-label="@NodeLabel(node)"
                   transform="translate(@Num(p.X) @Num(p.Y))"
                   @onclick="() => Select(node)" @onkeydown="e => OnKey(e, node)">
                    <title>@node.Title</title>
                    <rect class="node-box" width="@Num(RoadmapMapLayout.NodeWidth)" height="@Num(RoadmapMapLayout.NodeHeight)" />
                    <text class="node-icon" x="14" y="26">@Labels.Icon(node.State)</text>
                    <text x="34" y="26">@Truncate(node.Title, 22)</text>
                    <text class="node-sub" x="14" y="48">@SubLabel(node)</text>
                    @if (node.IsCurrent)
                    {
                        <g class="map-here" transform="translate(12 -22)">
                            <rect width="@(MentorView ? 118 : 82)" height="20" />
                            <text x="8" y="14">@(MentorView ? "Następny do zaliczenia" : "Tu jesteś")</text>
                        </g>
                    }
                </g>
            }
        </svg>
    </div>

    @if (selected is not null)
    {
        <div class="card mt-3" aria-live="polite">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@selected.Title</span>
                <span class="small text-secondary">@Labels.Of(selected.State)</span>
            </div>
            <div class="card-body">
                @if (selected.State == MapNodeState.NotInPlan)
                {
                    <div class="small text-secondary mb-2">
                        @(MentorView ? "Ten podtemat jest w katalogu, ale nie ma go w roadmapie mentee." : "Ten podtemat nie jest w Twoim planie.")
                    </div>
                    @if (MentorView && RoadmapId is not null)
                    {
                        <button class="btn btn-sm btn-primary" @onclick="() => AddToRoadmapAsync(selected)" disabled="@busy">Dodaj do roadmapy</button>
                        <ErrorAlert Error="addError" />
                    }
                }
                else if (selected.Assignments.Count == 0)
                {
                    <div class="small text-secondary">Brak przypisanych ćwiczeń.</div>
                }
                @foreach (var a in selected.Assignments)
                {
                    <div class="list-row px-0">
                        <div>
                            @if (MentorView)
                            {
                                <span class="fw-semibold">@a.ExerciseTitle</span>
                            }
                            else
                            {
                                <a href="@($"app/assignments/{a.AssignmentId}")" class="fw-semibold">@a.ExerciseTitle</a>
                            }
                            <div class="small text-secondary">@(a.IsRequired ? "wymagane" : "opcjonalne")</div>
                        </div>
                        <Badge Value="a.Status" />
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private static readonly MapNodeState[] LegendStates =
        [MapNodeState.Completed, MapNodeState.InProgress, MapNodeState.PendingReview, MapNodeState.NeedsRevision, MapNodeState.NotStarted, MapNodeState.Withdrawn, MapNodeState.NotInPlan];

    [Parameter, EditorRequired] public Guid MentorshipId { get; set; }
    [Parameter] public bool MentorView { get; set; }
    [Parameter] public Guid? RoadmapId { get; set; }
    [Parameter] public EventCallback OnTopicAdded { get; set; }

    private RoadmapMapDto? map;
    private MapLayout layout = new(0, 0, [], []);
    private Dictionary<Guid, RoadmapMapNodeDto> byId = [];
    private Guid? selectedId;
    private bool busy;
    private AppError? addError;
    private RoadmapMapNodeDto? selected => selectedId is { } id && byId.TryGetValue(id, out var n) ? n : null;

    protected override async Task OnParametersSetAsync() => await LoadAsync(keepSelection: map is not null);

    private async Task LoadAsync(bool keepSelection)
    {
        var user = await GetUserIdAsync();
        var result = MentorView
            ? await MapService.GetMapForMentorAsync(user, MentorshipId, Ct)
            : await MapService.GetMapForMenteeAsync(user, MentorshipId, Ct);
        if (Handle(result))
        {
            var previous = selectedId;
            map = result.Value;
            byId = map!.Nodes.ToDictionary(n => n.TopicId);
            layout = RoadmapMapLayout.Compute(map.Nodes.Select(n => new MapLayoutInput(n.TopicId, n.ParentTopicId)).ToList());
            selectedId = keepSelection && previous is { } p && byId.ContainsKey(p) ? p : map.Nodes.FirstOrDefault(n => n.IsCurrent)?.TopicId;
        }
        Loading = false;
    }

    private void Select(RoadmapMapNodeDto node)
    {
        selectedId = node.TopicId;
        addError = null;
    }

    private async Task AddToRoadmapAsync(RoadmapMapNodeDto node)
    {
        if (RoadmapId is not { } roadmapId) return;
        busy = true;
        var result = await Roadmaps.AddTopicAsync(await GetUserIdAsync(), new AddRoadmapTopicRequest(roadmapId, node.TopicId, null), Ct);
        if (result.IsSuccess)
        {
            addError = null;
            await LoadAsync(keepSelection: true);
            await OnTopicAdded.InvokeAsync();
        }
        else
        {
            addError = result.Error;
        }
        busy = false;
    }
    private void OnKey(KeyboardEventArgs e, RoadmapMapNodeDto node)
    {
        if (e.Key is "Enter" or " ") Select(node);
    }

    private static string Num(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string Truncate(string text, int max) => text.Length <= max ? text : text[..(max - 1)] + "…";

    private static string SubLabel(RoadmapMapNodeDto n) => n.State switch
    {
        MapNodeState.Withdrawn => "wycofany",
        MapNodeState.NotInPlan => "poza planem",
        _ => n.TotalRequired == 0 ? Labels.Of(n.State) : $"{Labels.Of(n.State)} · {n.CompletedRequired}/{n.TotalRequired} wymaganych",
    };

    private static string NodeLabel(RoadmapMapNodeDto n) =>
        $"{n.Title}, {Labels.Of(n.State)}{(n.IsCurrent ? ", bieżący temat" : "")}";
}
