<div class="mp-page mp-page--@Width @Class">@ChildContent</div>

@code {
    /// <summary>wide (dashboards, lists), reading (long text), narrow (forms).</summary>
    [Parameter] public string Width { get; set; } = "wide";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
