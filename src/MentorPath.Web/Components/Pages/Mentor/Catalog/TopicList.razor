@page "/mentor/catalog/topics"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Catalog
@using MentorPath.Application.Catalog.Contracts
@inject ITopicService Topics

<PageTitle>Katalog — MentorPath</PageTitle>

<Page>
    <PageHeader Title="Katalog tematów" Subtitle="Prywatny katalog Twojego workspace.">
        <Actions>
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="show-archived" checked="@includeArchived" @onchange="ToggleArchivedAsync" />
                <label class="form-check-label small" for="show-archived">Pokaż zarchiwizowane</label>
            </div>
            <button class="btn btn-primary" @onclick="() => showForm = !showForm">@(showForm ? "Anuluj" : "Nowy temat")</button>
        </Actions>
    </PageHeader>

    @if (showForm)
    {
        <Section Title="Nowy temat">
            <TopicForm Model="form" Error="Error" ParentOptions="TopicTreeView.ParentOptions(topics, null)" />
            <button class="btn btn-primary mt-3" @onclick="CreateAsync" disabled="@busy">Utwórz temat</button>
        </Section>
    }

    <PageState Loading="Loading" NotFound="NotFound">
        @if (topics.Count == 0)
        {
            <EmptyState Icon="library" Title="Katalog jest pusty">Utwórz pierwszy temat, aby dodawać ćwiczenia.</EmptyState>
        }
        else
        {
            <DataList Bordered="true">
                @foreach (var (t, depth) in TopicTreeView.Flatten(topics))
                {
                    <DataRow Href="@($"mentor/catalog/topics/{t.TopicId}")" Title="@((depth > 0 ? "└ " : "") + t.Title)" Class="@($"mp-tree-d{depth}")" Meta="@($"{t.Category} · {Labels.Of(t.Difficulty)} · {t.ExerciseCount} ćw.")">
                        <Aside>
                            @if (t.IsArchived) { <Badge Tone="secondary" Label="Zarchiwizowany" /> }
                        </Aside>
                    </DataRow>
                }
            </DataList>
        }
    </PageState>
</Page>

@code {
    private List<TopicListItem> topics = [];
    private bool includeArchived;
    private bool showForm;
    private bool busy;
    private TopicFormModel form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Topics.ListAsync(await GetUserIdAsync(), includeArchived, Ct);
        if (Handle(result)) topics = result.Value!.ToList();
        Loading = false;
    }

    private async Task ToggleArchivedAsync()
    {
        includeArchived = !includeArchived;
        await LoadAsync();
    }

    private async Task CreateAsync()
    {
        busy = true;
        if (string.IsNullOrWhiteSpace(form.Slug)) form.Slug = ExerciseValidator.Slugify(form.Title);
        var result = await Topics.CreateAsync(await GetUserIdAsync(), form.ToRequest(), Ct);
        if (Handle(result)) Nav.NavigateTo($"mentor/catalog/topics/{result.Value}");
        busy = false;
    }
}
