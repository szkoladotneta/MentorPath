@page "/"
@inject NavigationManager Nav
@using System.Security.Claims
@using MentorPath.Application.Mentorships.Contracts
@inject IMentorshipService Mentorships

<PageTitle>MentorPath</PageTitle>

<div class="auth-card">
    <h1 class="mb-2">MentorPath</h1>
    <p class="text-secondary mb-4">Platforma mentoringu architektury backendowej: scenariusz, decyzja, uzasadnienie, feedback, refleksja i postęp.</p>
    <a class="btn btn-primary w-100" href="Account/Login">Zaloguj się</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        if (user.IsInRole(AppRoles.Mentor)) Nav.NavigateTo("mentor");
        else if (user.IsInRole(AppRoles.Mentee))
        {
            // IAM-05: a mentee with more than one mentorship chooses the active relation after login.
            var userId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : Guid.Empty;
            var list = await Mentorships.ListForMenteeAsync(userId, CancellationToken.None);
            Nav.NavigateTo(list.IsSuccess && list.Value!.Count > 1 ? "app/mentorships" : "app");
        }
    }
}
