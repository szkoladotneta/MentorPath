@using MentorPath.Application.Catalog
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Tytuł</label>
        <input class="form-control" value="@Model.Title" @onchange="OnTitleChanged" />
        <FieldError Error="Error" Field="Title" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Slug</label>
        <InputText class="form-control" @bind-Value="Model.Slug" />
        <FieldError Error="Error" Field="Slug" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Kategoria</label>
        <InputText class="form-control" @bind-Value="Model.Category" placeholder="np. Architektura, Dane, Integracje" />
        <FieldError Error="Error" Field="Category" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Poziom trudności</label>
        <InputSelect class="form-select" @bind-Value="Model.Difficulty">
            @foreach (var d in Enum.GetValues<Difficulty>())
            {
                <option value="@d">@Labels.Of(d)</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-6">
        <label class="form-label">Temat nadrzędny</label>
        <InputSelect class="form-select" @bind-Value="Model.ParentTopicId">
            <option value="">— brak (temat główny) —</option>
            @foreach (var o in ParentOptions)
            {
                <option value="@o.Id">@o.Label</option>
            }
        </InputSelect>
        <div class="form-text">Podtematy tworzą gałąź (maks. @TopicLevels poziomy).</div>
        <FieldError Error="Error" Field="ParentTopicId" />
    </div>
    <div class="col-12">
        <label class="form-label">Opis (Markdown)</label>
        <InputTextArea class="form-control" rows="4" @bind-Value="Model.DescriptionMarkdown" />
        <FieldError Error="Error" Field="DescriptionMarkdown" />
    </div>
    <div class="col-12">
        <label class="form-label">Cele edukacyjne (Markdown)</label>
        <InputTextArea class="form-control" rows="4" @bind-Value="Model.LearningObjectivesMarkdown" />
        <FieldError Error="Error" Field="LearningObjectivesMarkdown" />
    </div>
</div>
<ErrorAlert Error="Error" ShowFieldList="false" />

@code {
    [Parameter, EditorRequired] public TopicFormModel Model { get; set; } = default!;
    [Parameter] public AppError? Error { get; set; }
    [Parameter] public IReadOnlyList<(Guid Id, string Label)> ParentOptions { get; set; } = [];

    private const int TopicLevels = 3;

    private void OnTitleChanged(ChangeEventArgs e)
    {
        var previousAuto = ExerciseValidator.Slugify(Model.Title);
        Model.Title = e.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(Model.Slug) || Model.Slug == previousAuto) Model.Slug = ExerciseValidator.Slugify(Model.Title);
    }
}
