@page "/app"
@attribute [Authorize(Roles = AppRoles.Mentee)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Mentorships.Contracts
@using MentorPath.Application.Roadmaps.Contracts
@using MentorPath.Web.Components.Modules.Progress
@inject IMentorshipService Mentorships
@inject IRoadmapService Roadmaps

<PageTitle>Dashboard — MentorPath</PageTitle>

<div class="page-header">
    <div>
        <h1>Twój mentoring</h1>
        <div class="subtitle">Bieżące zadania i postęp w każdej relacji mentoringowej.</div>
    </div>
    @if (items.Count > 1)
    {
        <a class="btn btn-outline-primary" href="app/mentorships">Zmień mentoring</a>
    }
</div>

<PageState Loading="Loading" NotFound="NotFound">
    @if (items.Count == 0)
    {
        <EmptyState Title="Nie masz aktywnych mentoringów">Poproś mentora o zaproszenie.</EmptyState>
    }
    @foreach (var m in items)
    {
        var roadmap = roadmaps.GetValueOrDefault(m.MentorshipId);
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>@m.WorkspaceName <span class="text-secondary fw-normal small">· mentor: @m.MentorDisplayName</span></span>
                <Badge Value="m.Status" />
            </div>
            <div class="card-body">
                @if (!m.OnboardingCompleted)
                {
                    <div class="alert alert-info py-2">Uzupełnij <a href="@($"app/profile?mentorshipId={m.MentorshipId}")">profil mentoringu</a>, aby mentor mógł dopasować ścieżkę.</div>
                }
                @if (m.Status == MentorshipStatus.Paused)
                {
                    <div class="alert alert-warning py-2">Mentoring jest wstrzymany — możesz przeglądać materiały, ale nie wysyłać nowych prób.</div>
                }
                <RoadmapProgressSummary MentorshipId="m.MentorshipId" />
                @if (roadmap is null)
                {
                    <p class="text-secondary small mt-3 mb-0">Mentor nie opublikował jeszcze roadmapy.</p>
                }
                else
                {
                    var next = roadmap.Items.SelectMany(i => i.Assignments.Select(a => (Topic: i.TopicTitle, A: a)))
                        .Where(x => x.A.LatestStatus is not (SubmissionStatus.Correct or SubmissionStatus.Accepted)).Take(4).ToList();
                    <div class="section-title mt-3">Następne zadania</div>
                    @if (next.Count == 0)
                    {
                        <p class="small text-success mb-0">Wszystkie zadania ukończone. 🎯</p>
                    }
                    @foreach (var (topic, a) in next)
                    {
                        <div class="list-row px-0">
                            <div>
                                <a href="@($"app/assignments/{a.AssignmentId}")">@a.ExerciseTitle</a>
                                <div class="small text-secondary">@topic · @Labels.Of(a.Type) · @(a.IsRequired ? "wymagane" : "opcjonalne") @(a.DueAtUtc is not null ? $"· termin {Labels.Day(a.DueAtUtc)}" : "")</div>
                            </div>
                            @if (a.LatestStatus is { } s) { <Badge Value="s" /> } else { <span class="badge text-bg-light">Nierozpoczęte</span> }
                        </div>
                    }
                    <a class="btn btn-sm btn-primary mt-3" href="@($"app/roadmap/{m.MentorshipId}")">Pełna roadmapa</a>
                }
            </div>
        </div>
    }
</PageState>

@code {
    private List<MenteeMentorshipListItem> items = [];
    private readonly Dictionary<Guid, MenteeRoadmapDto> roadmaps = [];

    protected override async Task OnInitializedAsync()
    {
        var user = await GetUserIdAsync();
        var result = await Mentorships.ListForMenteeAsync(user, Ct);
        if (Handle(result)) items = result.Value!.ToList();
        foreach (var m in items)
        {
            var r = await Roadmaps.GetForMenteeAsync(user, m.MentorshipId, Ct);
            if (r.IsSuccess) roadmaps[m.MentorshipId] = r.Value!;
        }
        Loading = false;
    }
}
