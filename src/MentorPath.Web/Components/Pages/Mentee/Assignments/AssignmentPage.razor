@page "/app/assignments/{AssignmentId:guid}"
@attribute [Authorize(Roles = AppRoles.Mentee)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using System.Text.Json
@using MentorPath.Application.Submissions.Contracts
@inject ISubmissionService Submissions
@inject IJSRuntime JS

<PageTitle>Zadanie — MentorPath</PageTitle>

<PageState Loading="Loading" NotFound="NotFound">
    @if (model is not null)
    {
        var ex = model.Exercise;
        <div class="page-header">
            <div>
                <a href="@($"app/roadmap/{model.MentorshipId}")" class="small">← Roadmapa · @model.TopicTitle</a>
                <h1>@ex.Title</h1>
                <div class="subtitle d-flex flex-wrap gap-2 align-items-center">
                    <Badge Value="ex.Type" />
                    <span>@(model.IsRequired ? "wymagane" : "opcjonalne")</span>
                    @if (model.DueAtUtc is not null) { <span>· termin @Labels.Day(model.DueAtUtc)</span> }
                    @if (ex.EstimatedMinutes is not null) { <span>· ok. @ex.EstimatedMinutes min</span> }
                </div>
            </div>
            @if (model.AttemptCount > 0)
            {
                <a class="btn btn-outline-primary" href="@($"app/assignments/{AssignmentId}/history")">Historia prób (@model.AttemptCount)</a>
            }
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-body">
                        <div class="section-title">@(ex.Type == ExerciseType.PracticalTask ? "Opis zadania" : "Scenariusz")</div>
                        <Markdown Value="@ex.ScenarioMarkdown" />
                        @if (ex.InstructionsMarkdown is not null)
                        {
                            <div class="section-title mt-3">Wymagania</div>
                            <Markdown Value="@ex.InstructionsMarkdown" />
                        }
                        @if (ex.ExpectedOutcomeMarkdown is not null)
                        {
                            <div class="section-title mt-3">Oczekiwany rezultat</div>
                            <Markdown Value="@ex.ExpectedOutcomeMarkdown" />
                        }
                        @if (ex.RubricMarkdown is not null)
                        {
                            <div class="section-title mt-3">Kryteria oceny</div>
                            <Markdown Value="@ex.RubricMarkdown" />
                        }
                        @if (ex.DiscussionQuestionsMarkdown is not null)
                        {
                            <div class="section-title mt-3">Pytania do przemyślenia</div>
                            <Markdown Value="@ex.DiscussionQuestionsMarkdown" />
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                @if (quizOutcome is not null)
                {
                    <div class="alert @(quizOutcome.IsCorrect ? "alert-success" : "alert-warning")">
                        <strong>@(quizOutcome.IsCorrect ? "Poprawna odpowiedź!" : "To nie jest najlepsza odpowiedź.")</strong>
                        <Markdown Value="@quizOutcome.SelectedOptionExplanationMarkdown" Class="mt-1" />
                        @if (quizOutcome.ExerciseExplanationMarkdown is not null)
                        {
                            <div class="section-title mt-2">Wyjaśnienie</div>
                            <Markdown Value="@quizOutcome.ExerciseExplanationMarkdown" />
                        }
                        @if (!quizOutcome.IsCorrect) { <div class="small mt-1">Możesz spróbować ponownie.</div> }
                    </div>
                }
                @if (successMessage is not null) { <div class="alert alert-success">@successMessage</div> }

                @if (model.SubmitBlockReason != SubmitBlockReason.None)
                {
                    <div class="alert alert-info">
                        @BlockText(model.SubmitBlockReason)
                        @if (model.AttemptCount > 0) { <div><a href="@($"app/assignments/{AssignmentId}/history")">Zobacz historię i feedback</a></div> }
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header">Twoja odpowiedź @(model.AttemptCount > 0 ? $"(próba #{model.AttemptCount + 1})" : "")</div>
                        <div class="card-body">
                            <ErrorAlert Error="Error" ShowFieldList="false" />
                            @switch (ex.Type)
                            {
                                case ExerciseType.QuizSingleChoice:
                                    <div class="mb-3">
                                        @foreach (var o in ex.QuizOptions)
                                        {
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="radio" name="quiz-option" id="@($"opt-{o.QuizOptionId}")"
                                                       checked="@(selectedOption == o.QuizOptionId)" @onchange="() => selectedOption = o.QuizOptionId" />
                                                <label class="form-check-label" for="@($"opt-{o.QuizOptionId}")">@o.Text</label>
                                            </div>
                                        }
                                        <FieldError Error="Error" Field="SelectedQuizOptionId" />
                                    </div>
                                    <label class="form-label">Uzasadnij wybór</label>
                                    <textarea class="form-control" rows="4" @bind="rationale"></textarea>
                                    <FieldError Error="Error" Field="RationaleMarkdown" />
                                    break;
                                case ExerciseType.ArchitecturalDecision:
                                    @foreach (var (field, label, hint) in DecisionFields)
                                    {
                                        <div class="mb-3">
                                            <label class="form-label">@label</label>
                                            <textarea class="form-control" rows="3" placeholder="@hint" value="@decision[field]" @onchange="e => decision[field] = e.Value?.ToString() ?? string.Empty"></textarea>
                                            <FieldError Error="Error" Field="@($"Answer.{field}")" />
                                        </div>
                                    }
                                    break;
                                case ExerciseType.PracticalTask:
                                    <div class="mb-3">
                                        <label class="form-label">Link do repozytorium lub artefaktu (http/https)</label>
                                        <input class="form-control" type="url" @bind="externalUrl" placeholder="https://github.com/…" />
                                        <FieldError Error="Error" Field="ExternalUrl" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">lub załącznik (PDF, TXT, MD, PNG, JPG — max 10 MB)</label>
                                        <input class="form-control" type="file" id="@fileInputId" accept=".pdf,.txt,.md,.png,.jpg,.jpeg" />
                                        <FieldError Error="Error" Field="File" />
                                    </div>
                                    <label class="form-label">Uzasadnienie decyzji implementacyjnych</label>
                                    <textarea class="form-control" rows="5" @bind="rationale"></textarea>
                                    <FieldError Error="Error" Field="RationaleMarkdown" />
                                    break;
                            }
                            <div class="mt-3">
                                <ConfidenceInput @bind-Value="confidence" />
                                <FieldError Error="Error" Field="ConfidenceBefore" />
                            </div>
                            <button class="btn btn-primary mt-3" @onclick="SubmitAsync" disabled="@busy">
                                @if (busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Wyślij
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</PageState>

@code {
    private static readonly (string Field, string Label, string Hint)[] DecisionFields =
    [
        ("Decision", "1. Decyzja", "Co wybierasz?"),
        ("Rationale", "2. Uzasadnienie", "Dlaczego właśnie to?"),
        ("Alternatives", "3. Alternatywy", "Jakie inne opcje rozważyłeś(-aś)?"),
        ("TradeOffs", "4. Kompromisy", "Co zyskujesz, a co tracisz?"),
        ("Risks", "5. Ryzyka", "Co może pójść nie tak?"),
        ("ReconsiderationConditions", "6. Warunki ponownej oceny", "Kiedy zmienisz tę decyzję?"),
    ];

    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    [Parameter] public Guid AssignmentId { get; set; }

    private MenteeAssignmentDto? model;
    private Guid clientRequestId = Guid.NewGuid();
    private Guid selectedOption;
    private string rationale = "";
    private string? externalUrl;
    private int confidence;
    private readonly Dictionary<string, string> decision = DecisionFields.ToDictionary(f => f.Field, _ => "");
    private readonly string fileInputId = $"file-{Guid.NewGuid():N}";
    private QuizOutcomeDto? quizOutcome;
    private string? successMessage;
    private bool busy;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Submissions.GetAssignmentForMenteeAsync(await GetUserIdAsync(), AssignmentId, Ct);
        if (Handle(result)) model = result.Value;
        Loading = false;
    }

    private async Task SubmitAsync()
    {
        busy = true;
        successMessage = null;
        quizOutcome = null;
        var user = await GetUserIdAsync();
        Result<SubmissionResultDto>? result = null;
        switch (model!.Exercise.Type)
        {
            case ExerciseType.QuizSingleChoice:
                result = await Submissions.SubmitQuizAsync(user, new SubmitQuizRequest(AssignmentId, clientRequestId, selectedOption, rationale, confidence), Ct);
                break;
            case ExerciseType.ArchitecturalDecision:
                var answer = new DecisionAnswerV1(decision["Decision"], decision["Rationale"], decision["Alternatives"], decision["TradeOffs"], decision["Risks"], decision["ReconsiderationConditions"]);
                result = await Submissions.SubmitDecisionAsync(user, new SubmitDecisionRequest(AssignmentId, clientRequestId, answer, confidence), Ct);
                break;
            case ExerciseType.PracticalTask:
                await SubmitPracticalAsync();
                break;
        }

        if (result is not null && Handle(result)) await OnSubmittedAsync(result.Value!);
        busy = false;
    }

    private async Task SubmitPracticalAsync()
    {
        var response = await JS.InvokeAsync<UploadResponse>("mentorPath.submitPractical", AssignmentId, fileInputId,
            new { clientRequestId, rationaleMarkdown = rationale, confidenceBefore = confidence, externalUrl });
        if (response.Status == 200)
        {
            Error = null;
            var dto = JsonSerializer.Deserialize<SubmissionResultDto>(response.Body!, Json)!;
            await JS.InvokeVoidAsync("mentorPath.clearFile", fileInputId);
            await OnSubmittedAsync(dto);
            return;
        }
        Error = response.Status switch
        {
            400 or 409 when response.Body is not null => JsonSerializer.Deserialize<AppError>(response.Body, Json),
            413 => Errors.Validation("submission.too_large", "Plik może mieć maksymalnie 10 MB."),
            429 => Errors.Conflict("submission.rate_limited", "Zbyt wiele prób wysyłki. Spróbuj za chwilę."),
            404 => Errors.NotFound("submission"),
            _ => Errors.Conflict("submission.upload_failed", "Nie udało się wysłać rozwiązania. Spróbuj ponownie."),
        };
    }

    private async Task OnSubmittedAsync(SubmissionResultDto dto)
    {
        clientRequestId = Guid.NewGuid();
        quizOutcome = dto.Quiz;
        successMessage = dto.Status == SubmissionStatus.PendingReview
            ? $"Próba #{dto.AttemptNumber} wysłana — czeka na ocenę mentora."
            : dto.Quiz is null ? $"Próba #{dto.AttemptNumber} zapisana." : null;
        if (dto.Quiz is null || !dto.Quiz.IsCorrect)
        {
            rationale = "";
            selectedOption = Guid.Empty;
        }
        await LoadAsync();
    }

    private static string BlockText(SubmitBlockReason reason) => reason switch
    {
        SubmitBlockReason.PendingReview => "Twoja ostatnia próba czeka na ocenę mentora. Kolejną możesz wysłać po otrzymaniu feedbacku.",
        SubmitBlockReason.AlreadyCompleted => "To zadanie jest zaliczone. Świetna robota!",
        SubmitBlockReason.MentorshipNotActive => "Mentoring jest wstrzymany — nie można wysyłać nowych prób.",
        SubmitBlockReason.AssignmentInactive => "To zadanie zostało wycofane z aktywnej ścieżki.",
        _ => "",
    };

    private sealed class UploadResponse
    {
        public int Status { get; set; }
        public string? Body { get; set; }
    }
}
