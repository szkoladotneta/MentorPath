@page "/mentor/mentees/{MentorshipId:guid}"
@attribute [Authorize(Roles = AppRoles.Mentor)]
@rendermode InteractiveServer
@inherits AppComponentBase
@using MentorPath.Application.Mentorships.Contracts
@using MentorPath.Web.Components.Modules.Progress
@inject IMentorshipService Mentorships

<PageTitle>Mentee — MentorPath</PageTitle>

<Page>
    <PageState Loading="Loading" NotFound="NotFound">
        @if (detail is not null)
        {
            <PageHeader Title="@detail.MenteeDisplayName" Crumbs="@(new[] { new Crumb("Mentees", "mentor/mentees"), new Crumb(detail.MenteeDisplayName) })">
                <ChildContent>
                    <p class="mp-page-header__subtitle">@detail.MenteeEmail · <Badge Value="detail.Status" /></p>
                </ChildContent>
                <Actions>
                    <a class="btn btn-primary" href="@($"mentor/mentees/{MentorshipId}/roadmap")">Roadmapa</a>
                </Actions>
            </PageHeader>
            <ErrorAlert Error="Error" />
            <SplitView Sticky="true">
                <Main>
                    <Section Title="Profil mentoringowy">
                        @if (detail.Goal is null)
                        {
                            <p class="text-secondary mb-0">Mentee nie uzupełnił(a) jeszcze onboardingu.</p>
                        }
                        else
                        {
                            <dl class="kv mb-0">
                                <dt>Cel mentoringu</dt><dd><Markdown Value="@detail.Goal" /></dd>
                                <dt>Poziom doświadczenia</dt><dd>@(detail.CurrentLevel is { } l ? Labels.Of(l) : "—")</dd>
                                <dt>Największe wyzwania</dt><dd><Markdown Value="@detail.Challenges" /></dd>
                                <dt>Dostępne godziny tygodniowo</dt><dd>@detail.WeeklyHours</dd>
                            </dl>
                        }
                    </Section>
                    <Section Title="Postęp">
                        <RoadmapProgressSummary MentorshipId="MentorshipId" ShowTopics="true" />
                    </Section>
                </Main>
                <Side>
                    <Section Title="Prywatne notatki">
                        <Aside>niewidoczne dla mentee, nie trafiają do AI</Aside>
                        <ChildContent>
                            <label class="visually-hidden-label" for="private-notes">Prywatne notatki</label>
                            <InputTextArea id="private-notes" class="form-control" rows="6" @bind-Value="notes" />
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <button class="btn btn-outline-primary btn-sm" @onclick="SaveNotesAsync" disabled="@busy">Zapisz notatki</button>
                                @if (notesSaved) { <span class="small text-success" role="status">Zapisano.</span> }
                            </div>
                        </ChildContent>
                    </Section>
                    <Section Title="Status relacji">
                        <label class="visually-hidden-label" for="mentorship-status">Status relacji</label>
                        <select id="mentorship-status" class="form-select" @bind="status">
                            @foreach (var s in Enum.GetValues<MentorshipStatus>())
                            {
                                <option value="@s">@Labels.Of(s)</option>
                            }
                        </select>
                        <div class="form-text">Wstrzymany: mentee tylko czyta. Zamknięty: mentee traci dostęp, dane zostają zachowane.</div>
                        <button class="btn btn-outline-primary btn-sm mt-3" @onclick="SaveStatusAsync" disabled="@(busy || status == detail.Status)">Zmień status</button>
                    </Section>
                </Side>
            </SplitView>
        }
    </PageState>
</Page>

@code {
    [Parameter] public Guid MentorshipId { get; set; }

    private MentorMenteeDetail? detail;
    private string? notes;
    private MentorshipStatus status;
    private bool busy;
    private bool notesSaved;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Mentorships.GetForMentorAsync(await GetUserIdAsync(), MentorshipId, Ct);
        if (Handle(result))
        {
            detail = result.Value;
            notes = detail!.MentorPrivateNotesMarkdown;
            status = detail.Status;
        }
        Loading = false;
    }

    private async Task SaveNotesAsync()
    {
        busy = true;
        notesSaved = Handle(await Mentorships.UpdatePrivateNotesAsync(await GetUserIdAsync(), MentorshipId, notes, Ct));
        busy = false;
    }

    private async Task SaveStatusAsync()
    {
        busy = true;
        if (Handle(await Mentorships.ChangeStatusAsync(await GetUserIdAsync(), MentorshipId, status, Ct))) await LoadAsync();
        busy = false;
    }
}
